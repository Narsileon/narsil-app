{
  "$schema": "https://json.schemastore.org/package.json",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build && vite build --ssr",
    "dev": "vite",
    "format:check": "prettier --check resources/js/**/*.{ts,tsx} vendor/narsil/cms/resources/js/**/*.{ts,tsx}",
    "format:write": "prettier --write resources/js/**/*.{ts,tsx} vendor/narsil/cms/resources/js/**/*.{ts,tsx}",
    "lint": "eslint resources/js/**/*.{ts,tsx} vendor/narsil/cms/resources/js/**/*.{ts,tsx} --ext .ts,.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@narsil/base": "workspace:*",
    "@narsil/cms": "workspace:*",
    "@narsil/cms-form": "workspace:*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^6.0.2"
  }
}
