{
  "$schema": "https://json.schemastore.org/package.json",
  "type": "module",
  "private": true,
  "workspaces": [
    "vendor/narsil/base",
    "vendor/narsil/cms",
    "vendor/narsil/cms-form"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format:check": "prettier --check \"resources/js/**/*.ts\" \"vendor/narsil/cms/resources/js/**/*.ts\"",
    "format:write": "prettier --write \"resources/js/**/*.ts\" \"vendor/narsil/cms/resources/js/**/*.ts\"",
    "lint": "eslint \"resources/js/**/*.ts\" \"vendor/narsil/cms/resources/js/**/*.ts\" --ext .ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3"
  }
}
